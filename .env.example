MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-root-password
MONGO_PASSWORD=replace-with-a-different-long-random-app-password
MONGODB_URI=mongodb://archive:replace-with-a-different-long-random-app-password@mongo:27017/facebook_archive?authSource=facebook_archive

# Optional Netscape-format yt-dlp cookies file, mounted from ./config.
# Example: COOKIE_FILE=/config/cookies.txt
COOKIE_FILE=

# debug, info, warn, or error
LOG_LEVEL=info
