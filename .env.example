# Paste your MongoDB connection URI here. For MongoDB Atlas, copy it from
# Atlas > Connect > Drivers. For local MongoDB use mongodb://localhost:27017.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/
MONGODB_DATABASE=facebook_archive

# Optional Netscape-format yt-dlp cookies file, mounted from ./config.
# Example: COOKIE_FILE=/config/cookies.txt
COOKIE_FILE=

# debug, info, warn, or error
LOG_LEVEL=info
